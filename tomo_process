#!/bin/bash
# tomo_process — CLI entry point for the tomogram processing pipeline.
#
# All /mnt access happens on the login node (orchestrator.sh runs here via nohup).
# Compute nodes never touch the network mount.
#
# Usage:
#   tomo_process --email <email> --path <relative_path_under_data_mount>
#   tomo_process --resume <run_id>
#   tomo_process --status <run_id>
#   tomo_process --list
#   tomo_process --cancel <run_id>

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=config.sh
source "${SCRIPT_DIR}/config.sh"

# ── Helpers ───────────────────────────────────────────────────────────────────
usage() {
    cat <<EOF
Usage:
  tomo_process --email <email> --path <relative_path_under_data_mount>
               [--max-jobs <N>]  [--mins-per-sample <N>]  [--nm <float>]

  tomo_process --status <run_id>   Show status of a running/finished run
  tomo_process --resume <run_id>   Resume after login node crash/disconnect
  tomo_process --list              List all runs
  tomo_process --cancel <run_id>   Cancel an active run

Examples:
  tomo_process --email me@lab.de --path "ProjectA/20260715_experiment"
  tomo_process --email me@lab.de --path "ProjectA/20260715_experiment" --nm 1.340
  tomo_process --status tomo_20260729_143201
  tomo_process --list

Notes:
  - <path> is relative to ${DATA_MOUNT}/
  - <path> can contain multiple subdirectories; all sample*_Tomog.mat files
    found recursively will be processed.
  - Chunk size is auto-derived: floor(walltime / --mins-per-sample).
    Default ${SLURM_TIME} walltime / ${MINS_PER_SAMPLE} min = $(( $(echo ${SLURM_TIME} | awk -F: '{print $1*60+$2}') / MINS_PER_SAMPLE )) samples per job.
  - Override per-sample estimate if your data is faster/slower: --mins-per-sample 10
  - Results: ${RESULTS_MOUNT}/<rel_path>/field_retrieval_zpe_results/
  - Scratch : ${SCRATCH_ROOT}/<run_id>/
  - The orchestrator runs as a nohup background process on the login node.
EOF
}

die()  { echo "ERROR: $*" >&2; exit 1; }
info() { echo "[tomo_process] $*"; }

# Resolve the user-supplied --path against DATA_MOUNT.
# Users often paste Windows-style paths (e.g. U:\Data\Members\...) whose leading
# folders don't exist under the mount. Strategy:
#   1. normalize slashes; strip a drive letter (U:), the mount path itself,
#      and leading/trailing slashes
#   2. try the path as given under DATA_MOUNT
#   3. drop up to 3 leading components, retrying after each
# Prints the resolved relative path on stdout; all messages go to stderr.
resolve_input_path() {
    local raw="$1"
    local p="${raw//\\//}"                 # backslash → forward slash
    if [[ "${p}" =~ ^[A-Za-z]:(.*)$ ]]; then
        p="${BASH_REMATCH[1]}"             # strip Windows drive letter (U:)
    fi
    p="${p#"${DATA_MOUNT}"}"               # strip the mount itself if included
    p="${p#/}"                             # strip leading slash
    p="${p%/}"                             # strip trailing slash

    local candidate="${p}" tried=() step
    for step in 0 1 2 3; do
        [[ -n "${candidate}" ]] || break
        if [[ -d "${DATA_MOUNT}/${candidate}" ]]; then
            if [[ "${step}" -gt 0 || "${candidate}" != "${raw}" ]]; then
                info "Resolved --path '${raw}' to '${candidate}' under ${DATA_MOUNT}/" >&2
            fi
            echo "${candidate}"
            return 0
        fi
        tried+=("${DATA_MOUNT}/${candidate}")
        [[ "${candidate}" == */* ]] || break
        candidate="${candidate#*/}"        # drop the first path component
    done

    {
        echo "ERROR: --path '${raw}' not found under ${DATA_MOUNT}."
        echo "  Tried:"
        local t
        for t in "${tried[@]}"; do
            echo "    ${t}"
        done
        echo ""
        echo "  --path must be relative to ${DATA_MOUNT}/ on the cluster, e.g.:"
        echo "    tomo_process --email you@lab.de --path \"Members/YourName/experiment_folder\""
        echo ""
        echo "  If you copied a Windows path (like U:\\...), drop the drive letter and"
        echo "  any folders above the mount point — keep only the part that exists"
        echo "  below ${DATA_MOUNT}/."
        echo "  Hint: run 'ls ${DATA_MOUNT}/' to see the available top-level folders."
    } >&2
    return 1
}

# ── Sub-command: list ─────────────────────────────────────────────────────────
cmd_list() {
    if [[ ! -d "${SCRATCH_ROOT}" ]]; then
        info "No runs found (${SCRATCH_ROOT} does not exist)."
        return
    fi
    local found=0
    for run_dir in "${SCRATCH_ROOT}"/tomo_*/; do
        [[ -d "${run_dir}" ]] || continue
        found=1
        local run_id
        run_id=$(basename "${run_dir}")
        local state_dir="${run_dir}/state"

        local done_n fail_n total_n
        done_n=$(wc -l < "${state_dir}/done_chunks.txt" 2>/dev/null || echo 0)
        fail_n=$(wc -l < "${state_dir}/failed_chunks.txt" 2>/dev/null || echo 0)
        total_n=$(wc -l < "${state_dir}/chunks.txt" 2>/dev/null || echo "?")

        local pid_file="${state_dir}/orchestrator.pid"
        local status="finished"
        if [[ -f "${pid_file}" ]]; then
            local pid
            pid=$(cat "${pid_file}")
            if kill -0 "${pid}" 2>/dev/null; then
                status="running (pid ${pid})"
            fi
        fi

        printf "  %-35s  chunks: %s/%s done, %s failed  [%s]\n" \
            "${run_id}" "${done_n}" "${total_n}" "${fail_n}" "${status}"
    done
    [[ "${found}" -eq 0 ]] && info "No runs found."
}

# ── Sub-command: status ───────────────────────────────────────────────────────
cmd_status() {
    local run_id="$1"
    local run_dir="${SCRATCH_ROOT}/${run_id}"
    [[ -d "${run_dir}" ]] || die "Run not found: ${run_id}"

    local state_dir="${run_dir}/state"
    local log_dir="${run_dir}/logs"

    echo "=== Run: ${run_id} ==="
    echo "Scratch : ${run_dir}"
    echo ""

    local total_n done_n fail_n active_n pending_n
    total_n=$(wc -l < "${state_dir}/chunks.txt"       2>/dev/null || echo 0)
    done_n=$(wc -l  < "${state_dir}/done_chunks.txt"  2>/dev/null || echo 0)
    fail_n=$(wc -l  < "${state_dir}/failed_chunks.txt" 2>/dev/null || echo 0)
    active_n=$(wc -l < "${state_dir}/active_jobs.txt" 2>/dev/null || echo 0)
    pending_n=$(( total_n - done_n - fail_n - active_n ))
    [[ "${pending_n}" -lt 0 ]] && pending_n=0

    printf "  Total chunks : %s\n" "${total_n}"
    printf "  Done         : %s\n" "${done_n}"
    printf "  Active       : %s\n" "${active_n}"
    printf "  Pending      : %s\n" "${pending_n}"
    printf "  Failed       : %s\n" "${fail_n}"
    echo ""

    if [[ -s "${state_dir}/active_jobs.txt" ]]; then
        echo "Active SLURM jobs:"
        while IFS=$'\t' read -r cid jid; do
            local state
            state=$(squeue -j "${jid}" -h -o "%T" 2>/dev/null || echo "COMPLETED/UNKNOWN")
            printf "  %-15s  job %-10s  %s\n" "${cid}" "${jid}" "${state}"
        done < "${state_dir}/active_jobs.txt"
        echo ""
    fi

    if [[ -s "${state_dir}/failed_chunks.txt" ]]; then
        echo "Failed chunks:"
        sed 's/^/  /' "${state_dir}/failed_chunks.txt"
        echo ""
        echo "  Logs: ${log_dir}/"
    fi

    echo "Orchestrator log (last 10 lines):"
    tail -10 "${log_dir}/orchestrator.log" 2>/dev/null | sed 's/^/  /' \
        || echo "  (no log yet)"
}

# ── Sub-command: cancel ───────────────────────────────────────────────────────
cmd_cancel() {
    local run_id="$1"
    local run_dir="${SCRATCH_ROOT}/${run_id}"
    [[ -d "${run_dir}" ]] || die "Run not found: ${run_id}"

    local state_dir="${run_dir}/state"

    local pid_file="${state_dir}/orchestrator.pid"
    if [[ -f "${pid_file}" ]]; then
        local pid
        pid=$(cat "${pid_file}")
        if kill -0 "${pid}" 2>/dev/null; then
            kill "${pid}" && info "Stopped orchestrator (pid ${pid})"
        else
            info "Orchestrator process ${pid} is not running"
        fi
    fi

    if [[ -s "${state_dir}/active_jobs.txt" ]]; then
        while IFS=$'\t' read -r cid jid; do
            scancel "${jid}" 2>/dev/null && info "Cancelled chunk ${cid} (job ${jid})" || true
        done < "${state_dir}/active_jobs.txt"
    fi

    info "Run ${run_id} cancelled. Scratch data left at ${run_dir} for inspection."
}

# ── Sub-command: start ────────────────────────────────────────────────────────
cmd_start() {
    local email="" input_path=""
    local max_jobs="${MAX_PARALLEL_JOBS}"
    local mins_per_sample="${MINS_PER_SAMPLE}"
    local nm="1.337"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --email)           email="$2";           shift 2 ;;
            --path)            input_path="$2";      shift 2 ;;
            --max-jobs)        max_jobs="$2";        shift 2 ;;
            --mins-per-sample) mins_per_sample="$2"; shift 2 ;;
            --nm)              nm="$2";              shift 2 ;;
            *) die "Unknown argument: $1. Run 'tomo_process --help' for usage." ;;
        esac
    done

    [[ -z "${email}" ]]      && die "--email is required"
    [[ -z "${input_path}" ]] && die "--path is required"

    local resolved_path
    resolved_path="$(resolve_input_path "${input_path}")" || exit 1
    input_path="${resolved_path}"
    local src_path="${DATA_MOUNT}/${input_path}"

    local nfiles
    nfiles=$(find "${src_path}" -name "sample*_Tomog.mat" | wc -l)
    [[ "${nfiles}" -gt 0 ]] || die "No sample*_Tomog.mat files found under ${src_path}"
    info "Found ${nfiles} sample files in ${src_path}"

    local run_id
    run_id="tomo_$(date '+%Y%m%d_%H%M%S')"
    local run_scratch="${SCRATCH_ROOT}/${run_id}"
    mkdir -p "${run_scratch}/state" "${run_scratch}/logs" "${run_scratch}/jobs"

    local pid_file="${run_scratch}/state/orchestrator.pid"

    # Save all run parameters so --resume can restart without re-specifying them
    cat > "${run_scratch}/state/run_env.sh" <<EOF
TOMO_RUN_ID="${run_id}"
TOMO_INPUT_PATH="${input_path}"
TOMO_EMAIL="${email}"
TOMO_MAX_JOBS="${max_jobs}"
TOMO_MINS_PER_SAMPLE="${mins_per_sample}"
TOMO_REPO_DIR="${SCRIPT_DIR}"
TOMO_SCRATCH_ROOT="${SCRATCH_ROOT}"
TOMO_DATA_MOUNT="${DATA_MOUNT}"
TOMO_RESULTS_MOUNT="${RESULTS_MOUNT}"
TOMO_POLL_INTERVAL="${POLL_INTERVAL}"
TOMO_SLURM_PARTITION="${SLURM_PARTITION}"
TOMO_SLURM_GRES="${SLURM_GRES}"
TOMO_SLURM_CPUS="${SLURM_CPUS}"
TOMO_SLURM_MEM="${SLURM_MEM}"
TOMO_SLURM_TIME="${SLURM_TIME}"
TOMO_NM="${nm}"
EOF

    info "Run ID          : ${run_id}"
    info "Scratch         : ${run_scratch}"
    info "Max parallel jobs: ${max_jobs}"
    info "Mins per sample : ${mins_per_sample} (chunk size auto-derived from walltime ${SLURM_TIME})"
    info "n_m             : ${nm}"

    # Launch orchestrator.sh as a nohup background process on the login node.
    # Pass all config via environment variables prefixed TOMO_ to avoid clashes.
    nohup env \
        TOMO_RUN_ID="${run_id}" \
        TOMO_INPUT_PATH="${input_path}" \
        TOMO_EMAIL="${email}" \
        TOMO_MAX_JOBS="${max_jobs}" \
        TOMO_MINS_PER_SAMPLE="${mins_per_sample}" \
        TOMO_REPO_DIR="${SCRIPT_DIR}" \
        TOMO_SCRATCH_ROOT="${SCRATCH_ROOT}" \
        TOMO_DATA_MOUNT="${DATA_MOUNT}" \
        TOMO_RESULTS_MOUNT="${RESULTS_MOUNT}" \
        TOMO_POLL_INTERVAL="${POLL_INTERVAL}" \
        TOMO_SLURM_PARTITION="${SLURM_PARTITION}" \
        TOMO_SLURM_GRES="${SLURM_GRES}" \
        TOMO_SLURM_CPUS="${SLURM_CPUS}" \
        TOMO_SLURM_MEM="${SLURM_MEM}" \
        TOMO_SLURM_TIME="${SLURM_TIME}" \
        TOMO_NM="${nm}" \
        bash "${SCRIPT_DIR}/scripts/orchestrator.sh" \
        >> "${run_scratch}/logs/orchestrator.log" 2>&1 &

    local bg_pid=$!
    echo "${bg_pid}" > "${pid_file}"

    info "Orchestrator running in background (pid ${bg_pid})"
    info ""
    info "You can safely disconnect. To check progress:"
    info "  tomo_process --status ${run_id}"
    info "  tomo_process --list"
    info ""
    info "Results will appear at:"
    info "  ${DATA_MOUNT}/${input_path}/_results/"
    info ""
    info "Full log:"
    info "  ${run_scratch}/logs/orchestrator.log"
}

# ── Sub-command: resume ───────────────────────────────────────────────────────
cmd_resume() {
    local run_id="$1"
    local run_dir="${SCRATCH_ROOT}/${run_id}"
    [[ -d "${run_dir}" ]] || die "Run not found: ${run_id}"

    local state_dir="${run_dir}/state"
    [[ -f "${state_dir}/chunks.txt" ]] || die "No chunks.txt found — run may not have started properly"

    # Check it's not already running
    local pid_file="${state_dir}/orchestrator.pid"
    if [[ -f "${pid_file}" ]]; then
        local pid
        pid=$(cat "${pid_file}")
        if kill -0 "${pid}" 2>/dev/null; then
            die "Orchestrator is already running (pid ${pid}). Use --status to check progress."
        fi
    fi

    # Read original run parameters from the saved env file
    local env_file="${state_dir}/run_env.sh"
    [[ -f "${env_file}" ]] || die "No run_env.sh found in state dir — cannot resume (missing original parameters)"
    # shellcheck source=/dev/null
    source "${env_file}"

    info "Resuming run: ${run_id}"
    info "Orchestrator will re-adopt any active SLURM jobs and continue from saved state"

    nohup env \
        TOMO_RUN_ID="${TOMO_RUN_ID}" \
        TOMO_INPUT_PATH="${TOMO_INPUT_PATH}" \
        TOMO_EMAIL="${TOMO_EMAIL}" \
        TOMO_MAX_JOBS="${TOMO_MAX_JOBS}" \
        TOMO_MINS_PER_SAMPLE="${TOMO_MINS_PER_SAMPLE}" \
        TOMO_REPO_DIR="${TOMO_REPO_DIR}" \
        TOMO_SCRATCH_ROOT="${TOMO_SCRATCH_ROOT}" \
        TOMO_DATA_MOUNT="${TOMO_DATA_MOUNT}" \
        TOMO_RESULTS_MOUNT="${TOMO_RESULTS_MOUNT}" \
        TOMO_POLL_INTERVAL="${TOMO_POLL_INTERVAL}" \
        TOMO_SLURM_PARTITION="${TOMO_SLURM_PARTITION}" \
        TOMO_SLURM_GRES="${TOMO_SLURM_GRES}" \
        TOMO_SLURM_CPUS="${TOMO_SLURM_CPUS}" \
        TOMO_SLURM_MEM="${TOMO_SLURM_MEM}" \
        TOMO_SLURM_TIME="${TOMO_SLURM_TIME}" \
        TOMO_NM="${TOMO_NM}" \
        bash "${SCRIPT_DIR}/scripts/orchestrator.sh" \
        >> "${run_dir}/logs/orchestrator.log" 2>&1 &

    local bg_pid=$!
    echo "${bg_pid}" > "${pid_file}"
    info "Orchestrator restarted (pid ${bg_pid})"
    info "  tomo_process --status ${run_id}"
}

# ── Dispatch ──────────────────────────────────────────────────────────────────
[[ $# -eq 0 ]] && { usage; exit 1; }

case "$1" in
    --help|-h)   usage ;;
    --list)      cmd_list ;;
    --resume)    [[ $# -ge 2 ]] || die "--resume requires a run_id"; cmd_resume "$2" ;;
    --status)    [[ $# -ge 2 ]] || die "--status requires a run_id"; cmd_status "$2" ;;
    --cancel)    [[ $# -ge 2 ]] || die "--cancel requires a run_id"; cmd_cancel "$2" ;;
    *)           cmd_start "$@" ;;
esac
